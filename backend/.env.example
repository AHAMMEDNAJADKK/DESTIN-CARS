# ==============================================================================
# DESTIN CABS — BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# Company: DESTIN PRIVATE LIMITED
# ==============================================================================

# Server Port (Render sets this dynamically via process.env.PORT)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=production

# MongoDB Atlas Production Connection String
# Replace <username>, <password>, and <cluster-address> with your actual MongoDB Atlas cluster credentials
# Ensure your IP or '0.0.0.0/0' is allowed in Atlas Network Access
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/destin_cabs?retryWrites=true&w=majority

# Vercel Production Frontend Origin (Used by CORS middleware)
# Example: https://destin-cabs.vercel.app
FRONTEND_URL=https://your-app-name.vercel.app
